# Copy this file to .env and adjust values.

LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_TIMEOUT_SECONDS=30
LLM_AGENT_LIMIT=55
LLM_CONCURRENCY=2

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

GPT_OSS_BASE_URL=http://localhost:8000/v1
GPT_OSS_MODEL=gpt-oss
GPT_OSS_API_KEY=

# ChatGPT OAuth bearer token example:
#   LLM_PROVIDER=chatgpt_oauth
#   CHATGPT_OAUTH_ACCESS_TOKEN should be provided via shell env, not committed.
#   CHATGPT_OAUTH_TOKEN_FILE may point to a local ignored token file.
CHATGPT_OAUTH_BASE_URL=https://api.openai.com/v1
CHATGPT_OAUTH_MODEL=
CHATGPT_OAUTH_ACCESS_TOKEN=
CHATGPT_OAUTH_TOKEN_FILE=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
